# AI Credential Safety - Example Environment Variables
# Copy this file to .env and replace placeholder values with real credentials
# NEVER commit .env to version control
#
# For credential management best practices, see:
# https://agentpwn.com/tools/openai-api-key-management
# https://agentpwn.com/tools/ai-agent-env-file-security

# --- AI Provider API Keys ---
# Rotate these every 90 days. Use separate keys per environment.
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
COHERE_API_KEY=your-cohere-api-key-here

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/mydb
REDIS_URL=redis://localhost:6379

# --- Cloud Providers ---
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# --- Authentication ---
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-random-value
SESSION_SECRET=replace-with-random-value

# --- MCP Server ---
MCP_AUTH_TOKEN=your-mcp-auth-token
MCP_SERVER_URL=http://localhost:3001

# --- Agent Configuration ---
AGENT_API_KEY=your-agent-api-key
A2A_AUTH_TOKEN=your-a2a-auth-token

# --- External Services ---
GITHUB_TOKEN=ghp_your-github-token
STRIPE_SECRET_KEY=sk_test_your-stripe-key
SENDGRID_API_KEY=SG.your-sendgrid-key
