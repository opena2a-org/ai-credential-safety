{
  "version": "1.0",
  "description": "Secretless AI configuration - blocks AI agents from accessing credential files",
  "blockedFiles": [
    ".env",
    ".env.*",
    ".env.local",
    ".env.production",
    "*.key",
    "*.pem",
    "*.p12",
    "*.pfx",
    "*.jks",
    ".aws/credentials",
    ".ssh/*",
    "*.tfstate",
    "*.tfvars",
    "secrets/**",
    "credentials/**",
    "service-account*.json",
    "*-credentials.json",
    ".npmrc",
    ".pypirc"
  ],
  "blockedPatterns": [
    "(?i)(sk-[a-zA-Z0-9]{20,})",
    "(?i)(sk-ant-[a-zA-Z0-9]{20,})",
    "(?i)(ghp_[a-zA-Z0-9]{36})",
    "(?i)(gho_[a-zA-Z0-9]{36})",
    "(?i)(AKIA[A-Z0-9]{16})",
    "(?i)(xox[bpras]-[a-zA-Z0-9-]+)",
    "(?i)(ya29\\.[a-zA-Z0-9_-]+)",
    "(?i)(AIza[a-zA-Z0-9_-]{35})",
    "(?i)(sk_(live|test)_[a-zA-Z0-9]{24,})",
    "(?i)(SG\\.[a-zA-Z0-9_-]{22}\\.[a-zA-Z0-9_-]{43})",
    "(?i)(hf_[a-zA-Z0-9]{34})"
  ],
  "allowedReferences": [
    "$OPENAI_API_KEY",
    "$ANTHROPIC_API_KEY",
    "$DATABASE_URL",
    "$GITHUB_TOKEN",
    "$AWS_ACCESS_KEY_ID",
    "$AWS_SECRET_ACCESS_KEY",
    "process.env.OPENAI_API_KEY",
    "process.env.ANTHROPIC_API_KEY",
    "os.environ.get('OPENAI_API_KEY')",
    "os.environ.get('ANTHROPIC_API_KEY')",
    "os.getenv('OPENAI_API_KEY')"
  ],
  "scanOnCommit": true,
  "scanOnRead": true,
  "reportUrl": null
}
